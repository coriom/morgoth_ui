{
  "name": "morgoth-vscode-connector",
  "displayName": "Morgoth Workspace Connector",
  "description": "Explicit, local and bounded Morgoth workspace connection",
  "publisher": "coriom",
  "version": "0.1.0",
  "private": true,
  "engines": { "vscode": "^1.140.0" },
  "extensionKind": ["workspace"],
  "main": "./out/extension.js",
  "activationEvents": ["onCommand:morgoth.connectWorkspace", "onCommand:morgoth.disconnectWorkspace"],
  "capabilities": { "untrustedWorkspaces": { "supported": false } },
  "contributes": { "commands": [
    { "command": "morgoth.connectWorkspace", "title": "Morgoth: Connect Workspace" },
    { "command": "morgoth.disconnectWorkspace", "title": "Morgoth: Disconnect" }
  ] },
  "scripts": { "build": "../../node_modules/.bin/tsc -p .", "test": "node --test out/protocol.test.js" }
}
