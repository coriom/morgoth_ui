  },
  "dependencies": {
    "@tanstack/react-query": "5.90.5",
    "@tauri-apps/api": "2.12.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.30",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
